# Copy to .env and replace change-me with your own password. Never commit .env.
POSTGRES_USER=fledge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fledge

# Used by the Python code (crawler, Alembic, tests).
DATABASE_URL=postgresql+psycopg://fledge:change-me@127.0.0.1:5432/fledge
TEST_DATABASE_URL=postgresql+psycopg://fledge:change-me@127.0.0.1:5432/fledge_test

# Email (alerts). Defaults point at Mailpit (docker compose), a local fake inbox:
# open http://localhost:8025 to see what was sent.
# For real sending (DECISIONS.md 2026-11-24), use the dedicated Fledge Gmail account:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_STARTTLS=yes
#   SMTP_USERNAME=<the Fledge Gmail address>  SMTP_PASSWORD=<its app password>
#   ALERT_FROM=<the same Gmail address>  (Gmail rewrites any other From address)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_STARTTLS=no
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM=alerts@fledge.localhost
MAILPIT_API=http://127.0.0.1:8025
